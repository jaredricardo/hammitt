{% style %}

  [data-section-id="{{ section.id }}"] {
    background-color: {{ section.settings.bg_color }};
  }

  [data-section-id="{{ section.id }}"] .swiper {
    --swiper-scrollbar-bg-color: #EDEDED;
    --swiper-scrollbar-drag-bg-color: #9C9C9C;
    --swiper-scrollbar-border-radius: 0px;
  }

  [data-section-id="{{ section.id }}"] .swiper-scrollbar {
    height: 1.5px;
  }

  [data-section-id="{{ section.id }}"] .swiper-scrollbar-drag {
    background: #9C9C9C;
    border-radius: 0;
	display: block;
  }

{% endstyle %}

{%- capture json -%}
  {
    "slidesPerView": 1.3,
    "spaceBetween": 20,
    "slidesOffsetAfter": 20,
    "scrollbar": {
      "el": ".image-and-link-scroller .swiper-scrollbar",
      "draggable": true
    },
    "breakpoints": {
      "990": {
        "slidesPerView": 3.4,
        "spaceBetween": 30,
        "slidesOffsetAfter": 30
      }
    }
  }
{%- endcapture -%}

<style>

  .image-and-link-scroller {
    padding: 6rem 0 4rem;
  }

    .image-and-link-scroller .swiper-wrapper {
		padding-bottom: 3rem !important;
	}

  .image-and-link-scroller__h1,
  .image-and-link-scroller__h2 {
    font-family: 'Adobe Carlson Italic' !important;
    font-style: italic;
    font-weight: 600 !important;
    margin-bottom: 3rem;
	font-size: 32px !important;
  }

  .image-and-link-scroller .swiper {
    overflow: hidden;
    padding-left: 1.5rem;
    padding-right: 0;
  }

  @media screen and (min-width: 750px) {
    .image-and-link-scroller .swiper {
      padding-left: 5rem;
      padding-right: 0;
    }
  }

  .image-link-card {
    display: block;
    width: 100%;
    text-decoration: none;
    color: inherit;
  }

  .image-link-card img {
    width: 100%;
    display: block;
  }

  .image-link-card-bottom-info {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    text-align: left;
    margin: 1.5rem 0 0;
  }

  .image-link-card-bottom-info h4 {
    font-family: 'Adobe Carlson Italic' !important;
    font-style: italic;
    font-weight: 600 !important;
    margin: 0.35rem 0;
  }

  .image-link-card-bottom-info p {
    margin: 0;
    font-weight: 600;
    text-decoration: underline;
  }

  @media screen and (max-width: 768px) {
    .image-and-link-scroller {
      padding: 3rem 0 2rem;
    }
	.image-and-link-scroller__h1,
	.image-and-link-scroller__h2  {
		font-size: 22px !important;
		margin-bottom: 1.5rem;
	}
  }

</style>

<section data-section-id="{{ section.id }}" {% if section.settings.section_anchor_id %} id="{{ section.settings.section_anchor_id }}" {% endif %}>
  <div class="page-width image-and-link-scroller">
	<div class="row page-width">
		{% if section.settings.header %}
			{% if section.settings.enable_h1 %}
				<h1 class="image-and-link-scroller__h1">{{ section.settings.header }}</h1>
			{% else %}
				<h2 class="image-and-link-scroller__h2">{{ section.settings.header }}</h2>
			{% endif %}
		{% endif %}
	</div>
	{% if section.blocks.size > 0 %}
		<div class="swiper" data-json='{{ json }}'>
			<div class="swiper-wrapper">
				{% for block in section.blocks %}
					<div class="swiper-slide">
						<a class="image-link-card" href="{{ block.settings.link }}">
							<img src="{{ block.settings.image | image_url: width: 800 }}" alt="Hammitt Image">
							<div class="image-link-card-bottom-info">
								<h4>{{ block.settings.title }}</h4>
								<p>{{ section.settings.link_out_text }}</p>
							</div>
						</a>
					</div>
				{% endfor %}
			</div>
			<div class="swiper-scrollbar"></div>
		</div>
	{% endif %}
  </div>
</section>

{% schema %}
{
	"name": "Image and Link Scroller",
  	"enabled_on": {
    	"templates": ["product", "collection", "page", "index", "article", "blog", "404", "cart", "search"]
  	},
	"settings": [
		{
			"type": "text",
			"id": "section_anchor_id",
			"label": "Section Anchor ID (optional)"
		},
		{
			"type": "color",
			"id": "bg_color",
			"label": "Background Color",
			"default": "#FFFFFF"
		},
		{
			"type": "text",
			"id": "header",
			"label": "Section Heading"
		},
		{
			"type": "checkbox",
			"id": "enable_h1",
			"label": "Use H1 for heading",
			"default": false
		},
		{
			"type": "text",
			"id": "link_out_text",
			"label": "Link Out Text",
			"default": "Shop Now"
		}
  	],
	"blocks": [
		{
			"type": "image_link",
			"name": "Image Link Card",
			"settings": [
				{
					"type": "image_picker",
					"id": "image",
					"label": "Image"
				},
				{
					"type": "text",
					"id": "title",
					"label": "Title"
				},
				{
					"type": "url",
					"id": "link",
					"label": "Link"
				}
			]
		}
	],
  	"presets": [
		{
			"name": "Image and Link Scroller"
		}
  	]
}
{% endschema %}