{% style %}

  [data-section-id="{{ section.id }}"] {
    background-color: {{ section.settings.bg_color }};
  }

{% endstyle %}

<style>
    .stores-header-new {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 5rem;
        padding-bottom: 5rem;
    }
    .stores-header-new .col:first-child {
        max-width: 560px;
    }
    .stores-header-new .col:nth-child(2) {
        display: flex;
        gap: 2rem;
        flex-wrap: wrap;
    }

    @media screen and (max-width: 768px) {
        .stores-header-new  {
            flex-direction: column;
            align-items: flex-start;
        }
        .stores-header-new .col:nth-child(2) {
            margin-top: 2rem;
        }
        .stores-header-new .col:nth-child(2) .button {
            width: 110px;
            min-width: max-content;
            max-width: 110px;
        }
    }
</style>

<section data-section-id="{{ section.id }}" {% if section.settings.section_anchor_id %} id="{{ section.settings.section_anchor_id }}" {% endif %}>
    <div class="page-width stores-header-new">
        <div class="col">
            <h1>{{ section.settings.header }}</h1>
            <p class="p-14">{{ section.settings.subheader }}</p>
        </div>
        <div class="col">
            {% if section.settings.button_one_link %}
                <a href="{{ section.settings.button_one_link }}" class="button transparent-button">{{ section.settings.button_one_text }}</a>
            {% endif %}
            {% if section.settings.button_two_link %}
                <a href="{{ section.settings.button_two_link }}" class="button transparent-button">{{ section.settings.button_two_text }}</a>
            {% endif %}
        </div>
    </div>
</section>

{% schema %}
{
  "name": "New Stores Header",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "text",
      "id": "section_anchor_id",
      "label": "Section Anchor ID (optional)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "text",
      "id": "header",
      "label": "Header Text"
    },
    {
      "type": "text",
      "id": "subheader",
      "label": "Subheader Text"
    },
    {
      "type": "text",
      "id": "button_one_text",
      "label": "Button One Text"
    },
    {
      "type": "url",
      "id": "button_one_link",
      "label": "Button One Link"
    },
    {
      "type": "text",
      "id": "button_two_text",
      "label": "Button Two Text"
    },
    {
      "type": "url",
      "id": "button_two_link",
      "label": "Button Two Link"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "New Stores Header"
    }
  ]
}
{% endschema %}