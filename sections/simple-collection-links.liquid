{% style %}

  [data-section-id="{{ section.id }}"] {
    background-color: {{ section.settings.bg_color }};
  }

{% endstyle %}

{% liquid
  assign filter_blocks = section.blocks | where: "type", "collection-filter-link"
  assign menu_group_blocks = section.blocks | where: "type", "menu-group"

  assign active_menu = nil
  assign matched_block_found = false
  for block in menu_group_blocks
    unless matched_block_found
      assign menu = linklists[block.settings.menu]
      for link in menu.links
        unless matched_block_found
          if link.url == collection.url
            assign active_menu = menu
            assign matched_block_found = true
          endif
        endunless
      endfor
    endunless
  endfor
%}

<section class="simple-collection-links" data-section-id="{{ section.id }}" {% if section.settings.section_anchor_id %} id="{{ section.settings.section_anchor_id }}" {% endif %}>
  {% if active_menu %}
    <ul>
      {% for link in active_menu.links %}
        <li>
          <a href="{{ link.url }}"{% if link.url == collection.url %} class="on-collection"{% endif %}>
            {{ link.title }}
          </a>
        </li>
      {% endfor %}
    </ul>
  {% elsif filter_blocks.size > 0 %}
    <ul>
      {% for block in filter_blocks %}
        <li>
          <a href="{{ block.settings.collection.url }}"{% if block.settings.collection.handle == collection.handle %} class="on-collection"{% endif %}>
            {% if block.settings.title != blank %}
              {{ block.settings.title | strip }}
            {% else %}
              {{ block.settings.collection.title | strip }}
            {% endif %}
          </a>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</section>

{% schema %}
{
  "name": "Simple collection links",
  "enabled_on": {
    "templates": ["product", "collection", "page", "index", "article", "blog", "404", "cart", "search"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Boilerplate section",
      "info": "Not for actual use in theme, just for copy-pasting when creating new sections. Delete this json object when creating a new section."
    },
    {
      "type": "text",
      "id": "section_anchor_id",
      "label": "Section Anchor ID (optional)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "menu-group",
      "name": "Menu Group",
      "settings": [
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "info": "Each link in this menu should point to a collection. If the visitor is on any of those collections, this menu's links will be rendered as the nav strip."
        }
      ]
    },
    {
      "type": "collection-filter-link",
      "name": "Collection Filter Link",
      "limit": 12,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection URL"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Alternative Collection Title (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Simple collection links"
    }
  ]
}
{% endschema %}
