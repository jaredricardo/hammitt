{% style %}

  [data-section-id="{{ section.id }}"] {
    background-color: {{ section.settings.bg_color }};
  }

{% endstyle %}

{% liquid
    assign has_collection_links = false
    assign filter_blocks = section.blocks | where: "type", "collection-filter-link"

    if filter_blocks.size > 0
        assign has_collection_links = true
    endif
%}

<section class="simple-collection-links" data-section-id="{{ section.id }}" {% if section.settings.section_anchor_id %} id="{{ section.settings.section_anchor_id }}" {% endif %}>
    {% if has_collection_links %}
        <ul>
          {% if collection.handle contains 'kyle' %}

            {%- comment -%} COLLECTION links for Kyle pages {%- endcomment -%}
            <li><a href="/collections/kyle"{% if collection.handle == 'kyle' %} class="on-collection"{% endif %}>The Kyle</a></li>
            <li><a href="/collections/doxie"{% if collection.handle == 'doxie' %} class="on-collection"{% endif %}>The Doxie</a></li>
            <li><a href="/collections/erica"{% if collection.handle == 'erica' %} class="on-collection"{% endif %}>The Erica</a></li>
            <li><a href="/collections/beverly"{% if collection.handle == 'beverly' %} class="on-collection"{% endif %}>The Beverly</a></li>
            <li><a href="/collections/meredith"{% if collection.handle == 'meredith' %} class="on-collection"{% endif %}>The Meredith</a></li>
            <li><a href="/collections/charles-crossbody"{% if collection.handle == 'charles-crossbody' %} class="on-collection"{% endif %}>The Charles</a></li>
            <li><a href="/collections/vip"{% if collection.handle == 'vip' %} class="on-collection"{% endif %}>The VIP</a></li>
            <li><a href="/collections/daniel"{% if collection.handle == 'daniel' %} class="on-collection"{% endif %}>The Daniel</a></li>
            <li><a href="/collections/bryant"{% if collection.handle == 'bryant' %} class="on-collection"{% endif %}>The Bryant</a></li>
            <li><a href="/collections/heiress-collection"{% if collection.handle == 'heiress-collection' %} class="on-collection"{% endif %}>Heiress Travel</a></li>

          {% elsif collection.handle contains 'black' %}

            {%- comment -%} COLOR & FABRIC links for Black pages {%- endcomment -%}
            <li><a href="/collections/suede"{% if collection.handle == 'suede' %} class="on-collection"{% endif %}>Suede</a></li>
            <li><a href="/collections/black"{% if collection.handle == 'black' %} class="on-collection"{% endif %}>Black</a></li>
            <li><a href="/collections/brown"{% if collection.handle == 'brown' %} class="on-collection"{% endif %}>Brown</a></li>
            <li><a href="/collections/holiday-neutrals"{% if collection.handle == 'holiday-neutrals' %} class="on-collection"{% endif %}>Neutrals</a></li>
            <li><a href="/collections/clear-bags"{% if collection.handle == 'clear-bags' %} class="on-collection"{% endif %}>Clear</a></li>
            <li><a href="/collections/warm-tones"{% if collection.handle == 'warm-tones' %} class="on-collection"{% endif %}>Warm Tones</a></li>
            <li><a href="/collections/cool-tones"{% if collection.handle == 'cool-tones' %} class="on-collection"{% endif %}>Cool Tones</a></li>
            <li><a href="/collections/white"{% if collection.handle == 'white' %} class="on-collection"{% endif %}>White</a></li>
            <li><a href="/collections/gold-collection"{% if collection.handle == 'gold-collection' %} class="on-collection"{% endif %}>Gold</a></li>
            <li><a href="/collections/silver-collection"{% if collection.handle == 'silver-collection' %} class="on-collection"{% endif %}>Silver</a></li>
            <li><a href="/collections/gunmetal-collection"{% if collection.handle == 'gunmetal-collection' %} class="on-collection"{% endif %}>Gunmetal</a></li>
            <li><a href="https://www.hammitt.com/products/kyle-revival-clutch-black-press-gold-silver-red-zip">Gold &amp; Silver</a></li>

          {% elsif collection.handle contains 'work-bags' %}

            {%- comment -%} OCCASION links for Work Bags pages {%- endcomment -%}
            <li><a href="/collections/travel"{% if collection.handle == 'travel' %} class="on-collection"{% endif %}>Travel</a></li>
            <li><a href="/collections/work-bags"{% if collection.handle == 'work-bags' %} class="on-collection"{% endif %}>Work</a></li>
            <li><a href="/collections/everyday-bags"{% if collection.handle == 'everyday-bags' %} class="on-collection"{% endif %}>Everyday</a></li>
            <li><a href="/collections/clear-bags"{% if collection.handle == 'clear-bags' %} class="on-collection"{% endif %}>Events</a></li>
            <li><a href="/collections/clutch"{% if collection.handle == 'clutch' %} class="on-collection"{% endif %}>Evening</a></li>
            <li><a href="/collections/wedding"{% if collection.handle == 'wedding' %} class="on-collection"{% endif %}>Wedding</a></li>

          {% else %}

            {%- comment -%} Default: render blocks configured in the theme editor {%- endcomment -%}
            {% comment %} 
              {% if request.page_type == "collection" %}
                <li>
                    <a href="{{ collection.url }}" class="on-collection">
                        {{ collection.title }}
                    </a>
                </li>
              {% endif %} 
            {% endcomment %}
            {% for block in filter_blocks %}
                <li>
                    <a href="{{ block.settings.collection.url }}" {% if block.settings.collection.handle == collection.handle %} class="on-collection"{% endif %}>
                        {% if block.settings.title != blank %}
                          {{ block.settings.title | strip }}
                        {% else %}
                          {{ block.settings.collection.title | strip }}
                        {% endif %}
                    </a>
                </li>
            {% endfor %}

          {% endif %}
        </ul>
    {% endif %}
</section>

{% schema %}
{
  "name": "Simple collection links",
  "enabled_on": {
    "templates": ["product", "collection", "page", "index", "article", "blog", "404", "cart", "search"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Boilerplate section",
      "info": "Not for actual use in theme, just for copy-pasting when creating new sections. Delete this json object when creating a new section."
    },
    {
      "type": "text",
      "id": "section_anchor_id",
      "label": "Section Anchor ID (optional)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "collection-filter-link",
      "name": "Collection Filter Link",
      "limit": 12,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection URL"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Alternative Collection Title (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Simple collection links"
    }
  ]
}
{% endschema %}