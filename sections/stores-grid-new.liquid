{% style %}

  [data-section-id="{{ section.id }}"] {
    background-color: {{ section.settings.bg_color }};
  }

{% endstyle %}

<style>
  .stores-grid-new-section {
    padding: 6rem 0 8rem;
  }

  .stores-grid-new {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: 2rem;
    row-gap: 4rem;
  }

  .new-store-card {
    width: 100%;
  }

  .new-store-card .store-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: start;
    text-align: left;
    max-width: 350px;
    margin: 1rem auto 0 auto;
  }

  .new-store-card .store-info h3 {
    font-style: italic;
    font-family: 'Adobe Carlson Italic' !important;
    font-weight: 600 !important;
    margin-bottom: 0.5rem;
    font-size: 32px !important;
  }

  .new-store-card img {
    width: 100%;
  }

  .new-store-card .phone {
    color: black;
    text-decoration: none;
  }

  .new-store-card .store-hours-rich-text * {
    font-style: italic;
    font-family: 'Adobe Carlson Italic' !important;
    font-size: 20px !important;
  }

  .stores-grid-new .button {
    min-width: unset;
    width: 160px;
    padding: 0;
  }

  .store-buttons-container {
    display: flex;
    flex-direction: row;
    gap: 3.5rem;
    margin-top: 1rem;
  }

  @media screen and (max-width: 768px) {
    .stores-grid-new-section {
      padding: 2rem 0 3rem;
    }

    .stores-grid-new {
      grid-template-columns: 1fr;
      column-gap: 1rem;
      row-gap: 3.5rem;
    }

    .new-store-card .store-info {
      align-items: flex-start;
    }

    .stores-grid-new .button {
      width: 130px;
    }
    .store-buttons-container  {
      gap: 1.5rem;
    }
    .new-store-card .store-info h3  {
      font-size: 26px;
    }
    .new-store-card .store-hours-rich-text * {
      font-size: 16px !important;
    }
    .new-store-card .store-info .p-large {
      font-size: 13px !important;
      margin: 1.25rem 0;
    }
  }
</style>

<section data-section-id="{{ section.id }}" class="stores-grid-new-section" {% if section.settings.section_anchor_id %} id="{{ section.settings.section_anchor_id }}" {% endif %}>
  <div class="page-width stores-grid-new">
    {% for block in section.blocks %}
      <div class="new-store-card">
        {% if block.settings.store_image %}
          <img src="{{ block.settings.store_image | image_url: width: 800 }}" alt="{{ block.settings.store_image.alt | default: 'Hammitt Store' }}">
        {% endif %}
        <div class="store-info">
          {% if block.settings.store_title %}
            <h3>{{ block.settings.store_title }}</h3>
          {% endif %}
          {% if block.settings.hours_rich_text %}
            <div class="store-hours-rich-text">
              {{ block.settings.hours_rich_text }}
            </div>
          {% endif %}
          {% if block.settings.store_address %}
            <p class="p-large">{{ block.settings.store_address }}</p>
          {% endif %}
          {% if block.settings.store_phone %}
            <p class="p-large"><a class="phone" href="tel:{{ block.settings.store_phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' }}">{{ block.settings.store_phone }}</a></p>
          {% endif %}
          <div class="store-buttons-container">
            {% if block.settings.get_directions %}
              <a href="{{ block.settings.get_directions }}" class="button transparent-button" target="_blank">
                Get Directions
              </a>
            {% endif %}
            <a href="#hammitt-events" class="button transparent-button">
              View Events
            </a>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "New Stores Grid",
  "enabled_on": {
    "templates": ["product", "collection", "page", "index", "article", "blog", "404", "cart", "search"]
  },
  "settings": [
    {
      "type": "text",
      "id": "section_anchor_id",
      "label": "Section Anchor ID (optional)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "store",
      "name": "Store Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "store_image",
          "label": "Store Image"
        },
        {
          "type": "text",
          "id": "store_title",
          "label": "Store Title",
          "default": "Hammitt Store"
        },
        {
          "type": "richtext",
          "id": "hours_rich_text",
          "label": "Store Hours",
          "default": "<p>Mon-Fri: 10am - 6pm<br>Sat: 10am - 5pm<br>Sun: Closed</p>"
        },
        {
          "type": "text",
          "id": "store_address",
          "label": "Store Address",
          "default": "123 Main St, Los Angeles, CA 90001"
        },
        {
          "type": "text",
          "id": "store_phone",
          "label": "Store Phone Number",
          "default": "(123) 456-7890"
        },
        {
          "type": "url",
          "id": "get_directions",
          "label": "Get Directions Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "New Stores Grid"
    }
  ]
}
{% endschema %}