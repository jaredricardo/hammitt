{% style %}

  [data-section-id="{{ section.id }}"] {
    background-color: {{ section.settings.bg_color }};
  }

{% endstyle %}

<style>
  .new-individual-store-page {
    padding: 6rem 0 8rem;
  }

  .new-individual-store-page .description-area * {
    font-size: 16px !important;
  }

  .new-individual-store-page .description-area em,
  .new-individual-store-page .description-area strong {
    font-family: 'Adobe Carlson Italic' !important;
    font-weight: 700 !important;
    font-size: 18px !important;
  }

  .new-store-card {
    width: 100%;
    display: flex;
    gap: 4rem;
    align-items: center;
  }

  .new-store-card img {
    max-width: 100%;
  }

  .new-store-card > img {
    flex: 1;
    min-width: 0;
    object-fit: cover;
  }

  .new-store-card .store-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: start;
    text-align: left;
  }
    .new-store-card h3 {
        margin-bottom: 0.5rem;
    }

   .new-store-card .store-hours-rich-text,
   .new-store-card .contact-area,
   .new-store-card .address-area {
        margin-top: 3rem;
        width: 100%;
   }

  .new-store-card .store-info h1 {
    font-style: italic;
    font-family: 'Adobe Carlson Italic' !important;
    font-weight: 600 !important;
    margin-bottom: 0.5rem;
    font-size: 32px !important;
  }

  .new-store-card img {
    width: 100%;
  }

  .new-store-card .phone {
    color: black;
    text-decoration: none;
  }

  .new-store-card .store-info h3 {
    color: #000;
    font-family: "Nunito Sans" !important;
    font-size: 16px !important;
    font-style: normal;
    font-weight: 700 !important;
    line-height: 150%;
  }
    .new-store-card .contact-area  {
        display: flex;
        gap: 0.5rem;
        flex-direction: column;
        align-items: start;
    }
  .new-store-card .store-hours-rich-text *,
  .new-store-card .contact-area p,
  .new-store-card .address-area p {
    color: #000 !important;
    font-family: "Nunito Sans" !important;
    font-size: 16px !important;
    font-style: normal !important;
    font-weight: 500 !important;
    line-height: 150% !important;
  }

  .new-individual-store-page .button {
    width: 50%;
    padding: 0;
  }

  .new-individual-store-page .description-area {
    max-width: 700px;
    margin: 0 auto;
    padding: 8rem 0;
  }

  .store-buttons-container {
    display: flex;
    flex-direction: row;
    gap: 3.5rem;
    margin-top: 4rem;
    width: 100%;
  }

  .triple-image-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1rem;
  }

  .triple-image-grid__top {
    grid-column: 1 / -1;
  }

  .triple-image-grid img {
    width: 100%;
    display: block;
    object-fit: cover;
  }

  .new-store-card p {
    margin: 0 !important; 
  }

  .new-individual-store-page .inner-container {
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .triple-image-grid.page-width {
    max-width: 1000px;
    margin: 0 auto;
  }

  @media screen and (max-width: 768px) {
    .new-store-card {
      flex-direction: column-reverse;
    }

    .new-store-card > img,
    .new-store-card .store-info {
      flex: unset;
      width: 100%;
    }

    .new-individual-store-page {
      padding: 2rem 0 3rem;
    }

    .new-individual-store-page {
      grid-template-columns: 1fr;
      column-gap: 1rem;
      row-gap: 3.5rem;
    }

    .new-store-card .store-info {
      align-items: flex-start;
    }

    .new-individual-store-page .button {
      flex: 1;
      width: auto !important;
      min-width: 0 !important;
      text-align: center;
    }
    .store-buttons-container  {
      gap: 1.5rem;
    }
    .new-store-card .store-info h3  {
      font-size: 13px;
    }
    .new-store-card .store-hours-rich-text *,
    .new-store-card .contact-area p,
    .new-store-card .address-area p {
      font-size: 13px !important;
    }
    .new-store-card .store-info .p-large {
      font-size: 13px !important;
      margin: 1.25rem 0;
    }
    .new-individual-store-page .description-area * {
      font-size: 14px !important;
    }
    .triple-image-grid.page-width {
        padding: 0 !important;
    }
    .new-individual-store-page .description-area {
        padding: 4rem 0 !important;
    }
    .new-store-card .store-hours-rich-text, 
    .new-store-card .contact-area, 
    .new-store-card .address-area {
        margin-top: 1.5rem !important;
    }
  }
</style>

<section data-section-id="{{ section.id }}" class="new-individual-store-page" {% if section.settings.section_anchor_id %} id="{{ section.settings.section_anchor_id }}" {% endif %}>
    <div class="page-width">
        <a href="/pages/our-stores" style="color: black; text-decoration: underline; font-size: 16px; margin-bottom: 2rem; display: inline-block;">
            Back to Our Stores
        </a>
        <div class="inner-container">
            <div class="new-store-card">
                <div class="store-info">
                    {% if page.title %}
                        <h1>{{ page.title }}</h1>
                    {% endif %}
                    {% if page.metafields.custom.hours_rich_text %}
                    <div class="store-hours-rich-text">
                        <h3>Store Hours</h3>
                        {{ page.metafields.custom.hours_rich_text | metafield_tag }}
                    </div>
                    {% endif %}
                    {% if page.metafields.custom.store_phone %}
                        <div class="contact-area">
                            <h3>Contact</h3>    
                            <p class="p-large" style="display:flex; gap: 1rem; align-items:center; justify-content:center;">
                                {% render 'icon-chat-bubble' %}
                                <a class="phone" href="tel:{{ page.metafields.custom.store_phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' }}">{{ page.metafields.custom.store_phone }}</a>
                            </p>
                            <a style="width: 100% !important; margin-top: 1rem;" class="button transparent-button" href="sms:{{ page.metafields.custom.store_phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' }}">Chat with us</a>
                        </div>
                    {% endif %}
                    {% if page.metafields.custom.store_address %}
                        <div class="address-area">
                            <h3>Address</h3>
                            {{ page.metafields.custom.store_address | metafield_tag }}
                        </div>
                    {% endif %}
                    <div class="store-buttons-container">
                        {% if page.metafields.custom.get_directions %}
                            <a href="{{ page.metafields.custom.get_directions }}" class="button transparent-button" target="_blank">
                            Get Directions
                            </a>
                        {% endif %}
                        <a href="/pages/our-stores#store-events" class="button transparent-button">
                            View Events
                        </a>
                    </div>
                </div>
                {% if page.metafields.custom.store_image.value %}
                    <img src="{{ page.metafields.custom.store_image.value | image_url: width: 800 }}" alt="{{ page.metafields.custom.store_image.value.alt | default: 'Hammitt Store' }}">
                {% endif %}
            </div>
            <div class="row">
                {% if page.content != blank %}
                    <div class="description-area">
                        {{ page.content }}
                    </div>
                {% endif %}
            </div>
            {%- assign triple_images = page.metafields.custom.store_triple_image.value -%}
        </div>
    </div>
    {% if triple_images != blank %}
        <div class="triple-image-grid page-width">
            {% for image in triple_images limit: 3 %}
                {% if forloop.first %}
                    <div class="triple-image-grid__top">
                        <img src="{{ image | image_url: width: 1600 }}" alt="{{ image.alt | default: 'Store image' }}">
                    </div>
                {% else %}
                    <img src="{{ image | image_url: width: 800 }}" alt="{{ image.alt | default: 'Store image' }}">
                {% endif %}
            {% endfor %}
        </div>
    {% endif %}
</section>

{% schema %}
{
  "name": "New Individual Store Page",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [],
  "presets": [
    {
      "name": "New Individual Store Page"
    }
  ]
}
{% endschema %}