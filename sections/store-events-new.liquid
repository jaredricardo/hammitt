{% style %}

  [data-section-id="{{ section.id }}"] {
    background-color: {{ section.settings.bg_color }};
  }

{% endstyle %}

<style>

  .store-events-section {
    padding: 4rem 0 6rem;
  }

    .store-events-section h2 {
        font-family: 'Adobe Carlson Italic' !important;
        font-style: italic;
        font-weight: 600 !important;
    }

  .store-events-section .swiper {
    max-width: var(--page-width);
    margin: 0 auto;
    padding-left: 1.5rem;
    padding-right: 0;
  }

  @media screen and (min-width: 750px) {
    .store-events-section .swiper {
      padding-left: 5rem;
      padding-right: 0;
    }
  }

  .store-events-swiper {
    overflow: hidden;
  }

  .events-card {
    width: 100%;
  }

  .event-tag {
    color: black;
    background-color: #F5F5F5;
    padding: 0.25rem 0.5rem;
    font-weight: 600;
  }

  .events-card img {
    width: 100%;
  }

    .events-card .p-large {
        margin: 0;
        font-family: 'Adobe Carlson Italic' !important;
        font-style: italic;
        margin: 0.35rem 0;
        font-weight: 600 !important;
    }

    .event-tag-container {
        display: flex;
        flex-direction: row;
        gap: 1.5rem;
        padding: 2rem 0;
        align-items: center;
        flex-wrap: wrap;
    }

  .events-card .event-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: start;
    text-align: left;
    margin: 1rem auto 0 auto;
  }

  .events-card .event-info h3 {
    font-style: italic;
    font-family: 'Adobe Carlson Italic' !important;
    font-weight: 600 !important;
    margin-bottom: 0.5rem;
    font-size: 32px !important;
  }

  .store-events .button {
    min-width: unset;
    width: 210px;
    padding: 0;
  }

  .filter-box {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .filter-box__trigger {
    display: flex;
    align-items: center;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0 1rem;
    font-size: inherit;
    font-family: inherit;
    width: 260px;
    height: 48px;
    border: 1px solid black;
  }


  .tag-filter-options {
    display: none;
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    background: white;
    border: 1px solid black;
    list-style: none;
    margin: 0;
    padding: 0;
    z-index: 10;
    width: 100%;
    max-height: 290px;
    overflow-y: auto;
  }

  .tag-filter-options.open {
    display: block;
  }

    .tag-filter-option,
    .filter-box__trigger {
        gap: 1.5rem;
    }

  .tag-filter-option {
    display: block;
    width: 100%;
    background: white;
    border: none;
    color: black;
    text-align: left;
    padding: 0 1rem;
    cursor: pointer;
    font-size: inherit;
    font-family: inherit;
    display: flex;
    align-items: center;
    flex-direction: row;
    height: 48px;
    font-weight: 600;
  }


  .tag-filter-option--clear {
    text-decoration: underline;
    text-align: center;
    justify-content: center;
  }

  .tag-filter-option:hover,
  .tag-filter-option:focus {
    background: #f5f5f5;
    outline: none;
  }

    .store-events-section .row:first-of-type {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        margin-bottom: 3rem;
        align-items: center;
    }

    .row-concierge {
        margin-top: 5rem;
        background-color: #FAFAFA;
        padding: 2rem 0;
    }
    .row-concierge p {
        color: black;
        font-weight: 500;
        font-size: 16px;
    }
    .store-events-section .event-description {
        color: #000;
        font-family: "Nunito Sans";
        font-size: 16px;
        font-style: normal;
        font-weight: 500;
        line-height: 150%; /* 24px */
        margin-bottom: 2.5rem;
    }

  .filter-box__trigger .icon-caret {
    transition: transform 300ms ease;
    max-width: 17px;
    margin-left: auto;
  }

  .filter-box__trigger[aria-expanded="true"] .icon-caret {
    transform: rotate(180deg);
  }

  @media screen and (max-width: 768px) {
    .store-events-section {
      padding: 2rem 0 3rem;
    }

    .events-card .event-info {
      align-items: flex-start;
    }

    .events-card .event-info h3 {
      font-size: 26px !important;
    }

    .store-events .button {
      width: 110px;
    }
    .filter-box__trigger {
        width: 170px;
        height: 40px;
    }
    .store-events-section .event-description {
        font-size: 14px;
    }
    .row-concierge p {
        font-size: 12px;
    }
    .row-concierge {
        margin-top: 2rem;
    }
  }
</style>


{% liquid

    assign tag_string = ''
    for block in section.blocks
        assign block_tags = block.settings.event_tags | split: ','
        for tag in block_tags
            assign trimmed = tag | strip
            if trimmed != ''
                assign tag_string = tag_string | append: trimmed | append: '||'
            endif
        endfor
    endfor
    assign unique_tags = tag_string | split: '||' | uniq

-%}

<script>
  (function() {
    document.addEventListener('DOMContentLoaded', function() {
      const sections = document.querySelectorAll('.store-events-section')

      sections.forEach(function(section) {
        const trigger = section.querySelector('.filter-box__trigger')
        const dropdown = section.querySelector('.tag-filter-options')
        const label = section.querySelector('.filter-box__label')
        const options = section.querySelectorAll('.tag-filter-option')
        const swiperEl = section.querySelector('.store-events-swiper')

        const swiperConfig = {
          slidesPerView: 1.3,
          slidesPerGroup: 1,
          spaceBetween: 20,
          loop: false,
          centeredSlides: false,
          slidesOffsetAfter: 20,
          breakpoints: {
            769: {
              slidesPerView: 3.4,
              slidesPerGroup: 1,
              spaceBetween: 30,
              slidesOffsetAfter: 30
            }
          }
        }

        let swiperInstance = new Swiper(swiperEl, swiperConfig)

        if (!trigger || !dropdown) return

        trigger.addEventListener('click', function() {
          const isOpen = dropdown.classList.contains('open')
          dropdown.classList.toggle('open')
          trigger.setAttribute('aria-expanded', String(!isOpen))
        })

        document.addEventListener('click', function(e) {
          if (!section.querySelector('.filter-box').contains(e.target)) {
            dropdown.classList.remove('open')
            trigger.setAttribute('aria-expanded', 'false')
          }
        })

        options.forEach(function(option) {
          option.addEventListener('click', function() {
            const selectedTag = this.dataset.tag
            label.textContent = selectedTag === '' ? 'All Stores' : selectedTag
            dropdown.classList.remove('open')
            trigger.setAttribute('aria-expanded', 'false')

            const slides = section.querySelectorAll('.store-events-swiper .swiper-slide')
            slides.forEach(function(slide) {
              const card = slide.querySelector('.events-card')
              if (selectedTag === '') {
                slide.style.display = ''
              } else {
                const cardTags = (card.dataset.tags || '').split('||').map(function(t) { return t.trim() })
                slide.style.display = cardTags.includes(selectedTag) ? '' : 'none'
              }
            })

            swiperInstance.update()
            swiperInstance.slideTo(0)
          })
        })
      })
    })
  })()
</script>

<section data-section-id="{{ section.id }}" class="store-events-section" {% if section.settings.section_anchor_id %} id="{{ section.settings.section_anchor_id }}" {% endif %}>
  <div class="">
        <div class="row header-row page-width">
            {% if section.settings.header %}
              <h2>{{ section.settings.header }}</h2>
            {% endif %}
            {% if section.blocks.size > 0 %}
                <div class="filter-box">
                    <button class="filter-box__trigger" aria-haspopup="listbox" aria-expanded="false" aria-label="Filter events by store location">
                        {% render 'icon-map-pin-no-outline' %}
                        <span class="filter-box__label">All Stores</span>
                        {% render 'icon-caret' %}
                    </button>
                    <ul class="tag-filter-options" role="listbox" aria-label="Store locations">
                        <li role="option">
                            <button class="tag-filter-option tag-filter-option--clear" data-tag="">Clear Filter</button>
                        </li>
                        {% for tag in unique_tags %}
                            {% if tag != '' %}
                            <li role="option">
                                <button class="tag-filter-option" data-tag="{{ tag }}">{% render 'icon-map-pin-no-outline' %} {{ tag }}</button>
                            </li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
        </div>
  </div>
        <div class="store-events-swiper swiper special-init-swiper page-width">
            <div class="store-events swiper-wrapper">
            {% for block in section.blocks %}
                {% assign raw_tags = block.settings.event_tags | split: ',' %}
                {% assign normalized_tags = '' %}
                {% for t in raw_tags %}
                    {% assign trimmed_t = t | strip %}
                    {% if trimmed_t != '' %}
                        {% assign normalized_tags = normalized_tags | append: trimmed_t | append: '||' %}
                    {% endif %}
                {% endfor %}
                <div class="swiper-slide">
                <div class="events-card" data-tags="{{ normalized_tags }}">
                    <img src="{{ block.settings.image |  image_url: width: 800  }}" alt="Hammitt Event Image">
                    <div class="event-info">
                        {% if block.settings.event_name %}
                            <h3>{{ block.settings.event_name }}</h3>
                        {% endif %}
                        {% if block.settings.date %}
                            <p class="p-large">{{ block.settings.date }}</p>
                        {% endif %}
                        {% if block.settings.time %}
                            <p class="p-large">{{ block.settings.time}}</p>
                        {% endif %}
                        {% if block.settings.event_tags %}
                            <div class="event-tag-container">
                                <span style="display: flex; align-items: center;">{% render 'icon-map-pin-no-outline' %}</span>
                                {% for tag in raw_tags %}
                                    {% assign trimmed_tag = tag | strip %}
                                    {% if trimmed_tag != '' %}
                                        <span class="event-tag">{{ trimmed_tag }}</span>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        {% endif %}
                        {% if block.settings.description %}
                            <div class="event-description">
                                {{ block.settings.description }}
                            </div>
                        {% endif %}
                        <a href="mailto:RSVP@hammitt.com" class="button transparent-button">
                            RSVP
                        </a>
                    </div>
                </div>
                </div>
            {% endfor %}
            </div>
        </div>
        <div class="row-concierge">
            <p class="concierge-callout page-width">
                Looking for a Hammitt boutique near you? Our Concierge team is here to help. Contact us Monday–Friday, 8:00 AM–6:00 PM PT, at 1-833-HAMMITT (1-833-426-6488).
            </p>
        </div>
</section>

{% schema %}
{
    "name": "Store Events",
    "enabled_on": {
        "templates": ["page"]
    },
    "settings": [
        {
            "type": "text",
            "id": "section_anchor_id",
            "label": "Section Anchor ID (optional)"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Background Color",
            "default": "#FFFFFF"
        },
        {
            "type": "text",
            "id": "header",
            "label": "Section Header"
        }
    ],
    "blocks": [
        {
            "type": "event",
            "name": "Event Card",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Event Image"
                },
                {
                    "type": "text",
                    "id": "event_name",
                    "label": "Event Name",
                    "default": "Event Name"
                },
                {
                    "type": "text",
                    "id": "date",
                    "label": "Event Date",
                    "default": "Event Date"
                },
                {
                    "type": "text",
                    "id": "time",
                    "label": "Event Time",
                    "default": "Event Time"
                },
                {
                    "type": "text",
                    "id": "event_tags",
                    "label": "Event Location / Tags",
                    "info": "Comma separated list of store locations for this event. Example: Manhattan Beach"
                },
                {
                    "type": "textarea",
                    "id": "description",
                    "label": "Event Description",
                    "default": "Lorum ipsum dolor sit amet, consectetur adipiscing elit. Sed euismod, nunc ut laoreet tincidunt, nunc nisl aliquam nunc, eget aliquam nisl nunc vel nisl."
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Store Events"
        }
    ]
}
{% endschema %}