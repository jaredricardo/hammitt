{% style %}

  [data-section-id="{{ section.id }}"] {
    background-color: {{ section.settings.bg_color }};
  }

{% endstyle %}

<style>

  .triple-image-grid-section {
    padding: 4rem 0;
  }

  .triple-image-grid {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: auto auto;
    gap: 1rem;
  }

  .triple-image-grid__top {
    width: 100%;
  }

  .triple-image-grid__bottom {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .triple-image-grid img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  @media screen and (max-width: 768px) {
    .triple-image-grid-section {
      padding: 2rem 0;
    }
  }

</style>

{%- assign triple_images = page.metafields.custom.store_triple_image.value -%}

<section data-section-id="{{ section.id }}" class="triple-image-grid-section" {% if section.settings.section_anchor_id %} id="{{ section.settings.section_anchor_id }}" {% endif %}>
  <div class="page-width triple-image-grid">

    {% if triple_images[0] %}
      <div class="triple-image-grid__top">
        <img src="{{ triple_images[0] | image_url: width: 1600 }}" alt="{{ triple_images[0].alt | default: 'Store image' }}">
      </div>
    {% endif %}

    {% if triple_images[1] or triple_images[2] %}
      <div class="triple-image-grid__bottom">
        {% if triple_images[1] %}
          <img src="{{ triple_images[1] | image_url: width: 800 }}" alt="{{ triple_images[1].alt | default: 'Store image' }}">
        {% endif %}
        {% if triple_images[2] %}
          <img src="{{ triple_images[2] | image_url: width: 800 }}" alt="{{ triple_images[2].alt | default: 'Store image' }}">
        {% endif %}
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Triple Image Grid",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "text",
      "id": "section_anchor_id",
      "label": "Section Anchor ID (optional)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Triple Image Grid"
    }
  ]
}
{% endschema %}
