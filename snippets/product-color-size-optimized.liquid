                      "product_tags": [{% for tag in product.tags%}{{ tag | json | replace: "'", "&#39;" }}{% unless forloop.last %},{% endunless %}{% endfor %}],
                      "product_title_type": {{ product_type | json | replace: "'", "&#39;" }},
                      "product_title_color_descriptor": {{ product_color | json | replace: "'", "&#39;" }},
                      "product_size": {{ product_size | json }},
                      "price": {{ product.selected_or_first_available_variant.price }}
                    }'
                  >
                    {% if product.featured_image %}
                      {{ product.featured_image | image_url: width: 700 | image_tag: alt: product.title, loading: 'lazy' }}
                    {% endif %}
                    <span class="drawerSwatch__label">{{ product_color }}</span>
                  </a>
                </div>
              </li>
            {% endcapture %}
            {% assign group_drawer_swatches = group_drawer_swatches | append: drawer_li %}
            {% assign group_drawer_count = group_drawer_count | plus: 1 %}
    
        {%- endfor -%}
      </ul>
    </div>
    {% if group_drawer_count > 0 %}
      {% capture drawer_tab %}<button type="button" class="pdp-colorway-drawer__category-btn{% if initial_variant_group == 'long-strap' %} active{% endif %}" data-drawer-group="long-strap">Long Strap</button>{% endcapture %}
      {% assign drawer_categories_html = drawer_categories_html | append: drawer_tab %}
      {% capture drawer_list %}<ul class="pdp-colorway-drawer__swatch-list{% if initial_variant_group == 'long-strap' %} active{% endif %}" data-drawer-group="long-strap">{{ group_drawer_swatches }}</ul>{% endcapture %}
      {% assign drawer_swatch_groups_html = drawer_swatch_groups_html | append: drawer_list %}
    {% endif %}
    {% if enable_variant_drawer %}
        <pdp-explore-more-colorways-drawer-trigger>
          Explore more size & colors
        </pdp-explore-more-colorways-drawer-trigger>

        <pdp-colorway-drawer class="pdp-colorway-drawer">
          <div class="pdp-colorway-drawer__underlay"></div>
          <div class="pdp-colorway-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ formatted_product_title }}">
            <div class="pdp-colorway-drawer__header">
              <h3 class="pdp-colorway-drawer__title">{{ formatted_product_title }}</h3>
              <button type="button" class="pdp-colorway-drawer__close" aria-label="{{ 'accessibility.close' | t }}">{% render 'icon-close' %}</button>
            </div>
            <div class="pdp-colorway-drawer__categories">{{ drawer_categories_html }}</div>
            <div class="pdp-colorway-drawer__swatch-groups">{{ drawer_swatch_groups_html }}</div>
          </div>
        </pdp-colorway-drawer>
      {% else %}
        <pdp-explore-more-colorways>
          Explore more size & colors
        </pdp-explore-more-colorways>
    {% endif %}

    <script class="hidden" type="application/json" id="data-product-variant-json">
      {
        "variant-data": {{ colorway_collection | json }}
      }
    </script>
  </div>
{% endif %}