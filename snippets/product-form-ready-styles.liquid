{% comment %}
  Keeps the product form submit button invisible and non-interactive until product-form.js
  has taken over the form submit and the variant id input is ready (adds .product-form--ready).
  Prevents an early tap from natively POSTing to /cart/add and leaving the PDP.
  Inline because base.css is lazy-loaded on product templates.
{% endcomment %}
<style>
  product-form .product-form__submit {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  product-form.product-form--ready .product-form__submit {
    opacity: 1;
    pointer-events: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    product-form .product-form__submit { transition: none; }
  }
</style>
<noscript>
  <style>
    product-form .product-form__submit { opacity: 1; pointer-events: auto; }
  </style>
</noscript>
