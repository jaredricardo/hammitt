{% comment %}
    usage:

    product: product object
    type: "pdp" or "card"

{% endcomment %}

<div class="{% if type == "pdp" %} card__badge-wrapper {% endif %} {% if type == "card" %}card__badge {{ settings.badge_position }} {% endif %}">

    {% liquid 

        assign special_tag_assigned = false
        assign product_tag_assigned = false
        assign is_only_a_few_left_tag = false
        assign has_top_gift_tag = false
        assign has_limited_edition_tag = false
        assign has_coming_soon_tag = false
        assign has_best_seller_tag = false
        assign has_final_sale_tag = false
        assign has_back_in_stock_tag = false
        assign badge_tag = ''

        # product.tags contains is case-sensitive, and "tag:" prefixed tags can have inconsistent
        # spacing (e.g. "tag:  new arrival" vs "tag: new arrival"), so build a normalized,
        # lowercased, "tag:"-stripped, whitespace-trimmed version of the tags to compare against
        assign tags_downcase = ''
        for tag in product.tags
            assign cleaned_tag = tag | downcase | remove: 'tag:' | strip
            assign tags_downcase = tags_downcase | append: '||' | append: cleaned_tag
        endfor

        if tags_downcase contains 'coming-soon'
            assign has_coming_soon_tag = true
            assign special_tag_assigned = true
            assign badge_tag = 'Coming Soon'
        endif

        if product.available == false and special_tag_assigned == false
            assign special_tag_assigned = true
        endif

        if tags_downcase contains 'final sale' or tags_downcase contains 'sample sale' and product.compare_at_price > product.price 
            assign has_final_sale_tag = true
            assign special_tag_assigned = true
            assign badge_tag = 'Sale'
        endif

        if product.variants[0].inventory_quantity <= settings.only_a_few_left_threshold and product.available and special_tag_assigned == false
            unless product.title contains 'Gift Card'
                assign special_tag_assigned = true
                assign is_only_a_few_left_tag = true
                assign badge_tag = settings.only_a_few_left_text
            endunless
        endif

        if tags_downcase contains 'seasonal favorites 25' and special_tag_assigned == false
            assign special_tag_assigned = true
            assign has_seasonal_favorite_tag = true
            assign badge_tag = 'Seasonal Favorite'
        endif

        if tags_downcase contains 'best-seller' and special_tag_assigned == false
            assign special_tag_assigned = true
            assign has_best_seller_tag = true
            assign badge_tag = 'Bestseller'
        endif

        if tags_downcase contains 'limited-release' and special_tag_assigned == false
            assign special_tag_assigned = true
            assign has_limited_edition_tag = true
            assign badge_tag = 'Limited Release'
        endif

        if tags_downcase contains 'celebrity-fav' and special_tag_assigned == false
            assign special_tag_assigned = true
            assign badge_tag = 'Celebrity Fave'
        endif

        if tags_downcase contains 'back-in-stock' and special_tag_assigned == false
            assign special_tag_assigned = true
            assign has_back_in_stock_tag = true
            assign badge_tag = 'Back in Stock'
        endif

        if tags_downcase contains 'new-arrival' and special_tag_assigned == false
            assign special_tag_assigned = true
            assign badge_tag = 'New Arrival'
        endif

        if tags_downcase contains 'new arrival' and special_tag_assigned == false
            assign special_tag_assigned = true
            assign badge_tag = 'New Arrival'
        endif

        if tags_downcase contains 'back in stock' and special_tag_assigned == false
            assign special_tag_assigned = true
            assign badge_tag = 'Back in Stock'
        endif

        if tags_downcase contains 'bestseller' and special_tag_assigned == false
            assign special_tag_assigned = true
            assign badge_tag = 'Bestseller'
        endif

        if tags_downcase contains 'celebrity fave' and special_tag_assigned == false
            assign special_tag_assigned = true
            assign badge_tag = 'Celebrity Fave'
        endif


        unless special_tag_assigned
            for tag in product.tags

                assign tag_to_check = tag | downcase

                if tag_to_check contains 'tag:'
                    assign product_tag_assigned = true
                    assign badge_tag = tag_to_check | remove: 'tag:' | strip
                endif

                if tag_to_check contains 'top gift'
                    assign has_top_gift_tag = true
                endif

            endfor
        endunless

    -%}

    {% comment %} 
        not using until nov
        {%- if product.compare_at_price > product.price and product.available -%}
            <span class="badge badge--bottom-left color-{{ settings.sale_badge_color_scheme }}">{{ 'products.product.on_sale' | t }}</span>
        {%- endif -%} 
    {% endcomment %}
        

    {% if has_top_gift_tag and product_tag_assigned == true and special_tag_assigned == false %}
        {% assign badge_tag = "Top Gift" %}
    {% endif %}
  
    {% if special_tag_assigned or product_tag_assigned %}
        {% if has_coming_soon_tag == true %}
            <span class="badge tag-badge badge--top-right">
                {{ badge_tag }}
            </span>
        {% elsif product.available == false %}
            <span class="badge tag-badge badge--{{ tag | handle }} badge--top-right color-{{ settings.sale_badge_color_scheme }}">
                Sold Out
            </span>
        {% elsif has_final_sale_tag %}
            <span class="badge red-badge">
                {{ badge_tag }}
            </span>
        {% elsif is_only_a_few_left_tag == true %}
            <span class="badge red-badge">
                {% render 'icon-timer' %}
                {{ settings.only_a_few_left_text }}
            </span>
        {% elsif has_seasonal_favorite_tag == true %}
            <span class="badge red-badge">
                {% render 'icon-limited-edition' %}
                {{ badge_tag }}
            </span>
        {% elsif has_best_seller_tag == true %}
            <span class="badge">
                {{ badge_tag }}
            </span>
        {% elsif has_limited_edition_tag == true %}
            <span class="badge gray-badge">
                {% render 'icon-limited-edition' %}
                {{ badge_tag }}
            </span>
        {% elsif has_back_in_stock_tag == true %}
            <span class="badge tag-badge badge--top-right">
                {{ badge_tag }}
            </span>
        {% elsif has_top_gift_tag == true %}
            <span class="badge red-badge">
                {% comment %} {% render 'icon-gift' %} {% endcomment %}
                <div class="gift-gif" role="img" style="background-image: url('{{ 'gift-gif.gif' | asset_url }}');" aria-label="Gift Icon"></div>
                {{ badge_tag }}
            </span>
        {% else %}
            <span class="badge tag-badge badge--{{ tag | handle }} badge--top-right color-{{ settings.sale_badge_color_scheme }}">
                {{ badge_tag }}
            </span>
        {% endif %}
    {% endif %}
</div>